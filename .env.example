# Stage 1 (대량 전처리) — https://platform.deepseek.com 에서 발급
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Stage 2 (최종 카피) — https://platform.claude.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 모델 교체 (선택)
#   Stage 1: deepseek-v4-flash | deepseek-v4-pro
#   Stage 2: claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5
#   ※ claude-haiku-4-5 는 캐시 최소 프리픽스가 4,096 토큰이라
#     현재 스타일 가이드(약 2,000 토큰)로는 캐시가 걸리지 않는다.
CP_STAGE1_MODEL=deepseek-v4-flash
CP_STAGE2_MODEL=claude-sonnet-5

# 훅 후보 개수 (많을수록 Stage 1 출력 토큰이 는다)
CP_HOOK_CANDIDATES=20

# 리포트 환산 환율
CP_USD_KRW=1400
